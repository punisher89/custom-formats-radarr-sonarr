{
  "name": "RU - Russian Language Archive",
  "includeCustomFormatWhenRenaming": false,
  "specifications": [
    {
      "name": "Restore Russian language score from saved Custom Format label",
      "implementation": "ReleaseTitleSpecification",
      "negate": false,
      "required": true,
      "fields": {
        "value": "(?i)(?<![A-Za-z0-9])RU[ ._-]+Russian[ ._-]+Language(?![A-Za-z0-9])"
      }
    }
  ]
}
